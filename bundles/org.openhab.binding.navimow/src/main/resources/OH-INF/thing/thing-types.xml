<?xml version="1.0" encoding="UTF-8"?>
<thing:thing-descriptions bindingId="navimow"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:thing="https://openhab.org/schemas/thing-description/v1.0.0"
	xsi:schemaLocation="https://openhab.org/schemas/thing-description/v1.0.0 https://openhab.org/schemas/thing-description-1.0.0.xsd">

	<!-- Bridge: Navimow Cloud Account -->
	<bridge-type id="bridge">
		<label>Navimow Account</label>
		<description>Connects to the Navimow cloud service and manages MQTT real-time updates.</description>

		<config-description>
			<parameter name="pollingInterval" type="integer" unit="s" min="60">
				<label>Polling Interval</label>
				<description>Interval in seconds for HTTP fallback polling. Set to 0 to disable polling (MQTT only).</description>
				<default>3600</default>
				<advanced>true</advanced>
			</parameter>
			<parameter name="apiBaseUrl" type="text">
				<label>API Base URL</label>
				<description>Override the Navimow API base URL. Leave empty to use the default.</description>
				<default>https://navimow-fra.ninebot.com</default>
				<advanced>true</advanced>
			</parameter>
		</config-description>
	</bridge-type>

	<!-- Thing: Navimow Mower -->
	<thing-type id="mower">
		<supported-bridge-type-refs>
			<bridge-type-ref id="bridge"/>
		</supported-bridge-type-refs>

		<label>Navimow Mower</label>
		<description>A Segway Navimow robotic lawn mower.</description>

		<category>LawnMower</category>

		<semantic-equipment-tag>LawnMower</semantic-equipment-tag>

		<channels>
			<channel id="status" typeId="mower-status"/>
			<channel id="command" typeId="mower-command"/>
			<channel id="battery-level" typeId="battery-level"/>
			<channel id="mow-start-type" typeId="mow-start-type"/>
			<channel id="current-mow-boundary" typeId="current-mow-boundary"/>
			<channel id="current-mow-progress" typeId="current-mow-progress"/>
			<channel id="mowing-percentage" typeId="mowing-percentage"/>
			<channel id="subtotal-area" typeId="subtotal-area"/>
			<channel id="mowing-week-area" typeId="mowing-week-area"/>
			<channel id="posture-theta" typeId="posture-theta"/>
			<channel id="posture-x" typeId="posture-x"/>
			<channel id="posture-y" typeId="posture-y"/>
			<channel id="error-code" typeId="error-code"/>
			<!-- <channel id="signal-strength" typeId="signal-strength"/> -->
			<!-- <channel id="location" typeId="mower-location"/> -->
		</channels>

		<representation-property>deviceId</representation-property>

		<config-description>
			<parameter name="deviceId" type="text" required="true">
				<label>Device ID</label>
				<description>The unique device ID of the Navimow mower.</description>
			</parameter>
		</config-description>
	</thing-type>

	<!-- Channel Types -->

	<channel-type id="mower-status">
		<item-type>String</item-type>
		<label>Status</label>
		<description>Current operational state of the mower.</description>
		<tags>
			<tag>Control</tag>
			<tag>Mode</tag>
		</tags>
		<state readOnly="true">
			<options>
				<option value="idle">Idle</option>
				<option value="mowing">Mowing</option>
				<option value="paused">Paused</option>
				<option value="docked">Docked</option>
				<option value="charging">Charging</option>
				<option value="returning">Returning to Base</option>
				<option value="error">Error</option>
				<option value="unknown">Unknown</option>
			</options>
		</state>
	</channel-type>

	<channel-type id="battery-level">
		<item-type>Number:Dimensionless</item-type>
		<label>Battery Level</label>
		<description>Current battery level of the mower (percentage).</description>
		<tags>
			<tag>Status</tag>
			<tag>StateOfCharge</tag>
		</tags>
		<state readOnly="true" pattern="%d %%"/>
	</channel-type>

	<channel-type id="signal-strength">
		<item-type>Number</item-type>
		<label>Signal Strength</label>
		<description>RSSI signal strength of the mower (dBm).</description>
		<tags>
			<tag>Status</tag>
			<tag>SignalStrength</tag>
		</tags>
		<state readOnly="true" pattern="%d dBm"/>
	</channel-type>

	<channel-type id="mower-location">
		<item-type>Location</item-type>
		<label>Location</label>
		<description>Current GPS position of the mower (latitude, longitude).</description>
		<tags>
			<tag>Status</tag>
			<tag>GeoLocation</tag>
		</tags>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="error-code">
		<item-type>String</item-type>
		<label>Error Code</label>
		<description>Error code reported by the mower, or "none" if there is no error.</description>
		<tags>
			<tag>Status</tag>
			<tag>Info</tag>
		</tags>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="current-mow-boundary">
		<item-type>Number</item-type>
		<label>Current Mow Boundary</label>
		<description>The boundary identifier where the mower is currently operating.</description>
		<tags>
			<tag>Status</tag>
			<tag>Info</tag>
		</tags>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="current-mow-progress">
		<item-type>Number:Dimensionless</item-type>
		<label>Current Mow Progress</label>
		<description>The mowing progress within the current boundary.</description>
		<tags>
			<tag>Status</tag>
			<tag>Progress</tag>
		</tags>
		<state readOnly="true" pattern="%.2f %%"/>
	</channel-type>

	<channel-type id="mowing-percentage">
		<item-type>Number:Dimensionless</item-type>
		<label>Mowing Percentage</label>
		<description>The overall mowing progress for the current task.</description>
		<tags>
			<tag>Status</tag>
			<tag>Progress</tag>
		</tags>
		<state readOnly="true" pattern="%d %%"/>
	</channel-type>

	<channel-type id="mowing-week-area">
		<item-type>Number:Area</item-type>
		<label>Mowing Week Area</label>
		<description>Total area mowed this week.</description>
		<tags>
			<tag>Status</tag>
			<tag>Info</tag>
		</tags>
		<state readOnly="true" pattern="%.2f %unit%"/>
	</channel-type>

	<channel-type id="subtotal-area">
		<item-type>Number:Area</item-type>
		<label>Subtotal Area</label>
		<description>Current activity subtotal area.</description>
		<tags>
			<tag>Status</tag>
			<tag>Info</tag>
		</tags>
		<state readOnly="true" pattern="%.2f %unit%"/>
	</channel-type>

	<channel-type id="mow-start-type">
		<item-type>String</item-type>
		<label>Mow Start Type</label>
		<description>Mowing start type indicator from the location telemetry stream (format to be determined).</description>
		<tags>
			<tag>Status</tag>
			<tag>Info</tag>
		</tags>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="posture-theta">
		<item-type>Number:Angle</item-type>
		<label>Posture Theta</label>
		<description>Mower's current heading angle.</description>
		<tags>
			<tag>Status</tag>
			<tag>Position</tag>
		</tags>
		<state readOnly="true" pattern="%.3f %unit%"/>
	</channel-type>

	<channel-type id="posture-x">
		<item-type>Number</item-type>
		<label>Posture X</label>
		<description>Mower's current X relative coordinate.</description>
		<tags>
			<tag>Status</tag>
			<tag>Position</tag>
		</tags>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="posture-y">
		<item-type>Number</item-type>
		<label>Posture Y</label>
		<description>Mower's current Y relative coordinate.</description>
		<tags>
			<tag>Status</tag>
			<tag>Position</tag>
		</tags>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="mower-command">
		<item-type>String</item-type>
		<label>Command</label>
		<description>Send a command to the mower.</description>
		<tags>
			<tag>Control</tag>
			<tag>Mode</tag>
		</tags>
		<state>
			<options>
				<option value="start">Start Mowing</option>
				<option value="stop">Stop Mowing</option>
				<option value="pause">Pause</option>
				<option value="resume">Resume</option>
				<option value="dock">Return to Base</option>
			</options>
		</state>
	</channel-type>

</thing:thing-descriptions>
